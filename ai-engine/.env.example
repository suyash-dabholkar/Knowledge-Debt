# Copy this file to .env and fill in values. Never commit the real .env file.

# If LLM_API_KEY is left blank, the app runs in deterministic fallback/demo
# mode and never fails due to a missing or unavailable LLM.
LLM_API_KEY=
LLM_API_URL=https://api.anthropic.com/v1/messages
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=20

# Mastery thresholds (see services/reassessment_service.py)
MASTERY_THRESHOLD_MASTERED=80
MASTERY_THRESHOLD_IMPROVING=60
MASTERY_NEW_SCORE_WEIGHT=0.7
DEBT_REDUCED_MIN_IMPROVEMENT=10
